# RunPod Serverless Environment
LOG_LEVEL=info

# Model Configuration
MODEL_NAME=Qwen3.8-27B-GGUF
MODEL_PATH=/models/Qwen3.8-27B-GGUF-Q8_0.gguf
CONTEXT_SIZE=200000
GPU_LAYERS=999
PARALLEL=8
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
API_KEY=

# Internal llama.cpp Backend Engine
LLAMA_BACKEND_MODE=real
LLAMA_SERVER_BINARY=llama-server
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_CONTEXT_SIZE=200000
MAX_CONTEXT_TOKENS=200000
REQUEST_TIMEOUT_SECONDS=180
